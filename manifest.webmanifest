{
  "id": "./",
  "name": "蝶迹 · 甲状腺健康记录",
  "short_name": "蝶迹",
  "description": "记录甲功指标与参考范围，查看趋势，管理每日状态、用药和复查，并生成就诊摘要。所有数据只保存在本机。",
  "lang": "zh-CN",
  "dir": "ltr",
  "start_url": "./#/overview",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#f4f1e9",
